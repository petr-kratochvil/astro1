{
  "compilerOptions": {
    /* Bundler-mode TS for Vite: tsc only type-checks, esbuild/Vite does the actual transpile. */
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,

    /* JS/TS interop: lets .js/.jsx and .ts/.tsx coexist during the incremental migration. */
    "allowJs": true,
    "checkJs": false,

    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "strict": true
  },
  "include": ["src"]
}
